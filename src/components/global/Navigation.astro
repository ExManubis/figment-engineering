---
import logo from '../../assets/pixel-perfection-logo.svg';
---

<header class="flex items-center justify-between z-10 relative">
	<a href="/" class="logo flex items-center gap-3 opacity-0">
		<img src={logo.src} width="18" height="21" alt="" aria-hidden="true" />
		<span class="font-display text-md tracking-wide text-cream"
			>Pixel Perfection</span
		>
	</a>
	<nav class="header-nav flex items-center gap-8 opacity-0 max-sm:gap-5">
		<a
			href="#"
			class="hidden text-[13px] text-cream/40 transition-opacity duration-300 hover:opacity-90"
			>Work</a
		>
		<a
			href="#"
			class="hidden text-[13px] text-cream/40 transition-opacity duration-300 hover:opacity-90"
			>About</a
		>
		<a
			href="#"
			class="hidden text-[13px] text-cream/40 transition-opacity duration-300 hover:opacity-90"
			>Contact</a
		>
	</nav>
</header>

<style>
	.logo {
		animation: slideDown 0.6s ease forwards 0.15s;
	}

	.header-nav {
		animation: slideDown 0.6s ease forwards 0.25s;
	}
</style>
