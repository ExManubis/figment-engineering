---
import PixelIcon from '../icons/PixelIcon.astro';
import { footerLinks } from '../../data/site';

const ICONS: Record<string, 'github' | 'x' | 'linkedin' | 'smallclaims'> = { GitHub: 'github', 'x.com': 'x', LinkedIn: 'linkedin', smallclaims: 'smallclaims' };
---

<footer id="contact" class="label mx-auto flex max-w-[1200px] flex-col gap-6 px-6 pt-10 pb-16 sm:flex-row sm:items-center sm:justify-between">
	<h2 class="sr-only">Contact</h2>
	<ul class="flex flex-wrap gap-x-8 gap-y-3">
		{footerLinks().map((l) => (
			<li><a class="link inline-flex items-center gap-2" href={l.href}>{ICONS[l.label] && <PixelIcon name={ICONS[l.label]} />}{l.label}</a></li>
		))}
	</ul>
	<p class="text-muted">© 2026 Figment Engineering</p>
</footer>
