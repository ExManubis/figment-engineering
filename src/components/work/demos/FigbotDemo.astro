---
import { GRID, POSES, cells } from '../../../../figbot/src/model';
import { toSvg } from '../../../../figbot/src/svg';

// the server renders Idle as a still; the script plays the loop over it
const still = toSvg(cells(POSES.idle, GRID, GRID), GRID, GRID);
---

<div class="figbot-demo" data-figbot-demo role="img" aria-label="Figbot, a halftone mascot, cycling through its expressions">
	<div class="layer" data-figbot-still set:html={still} />
	<canvas class="layer" data-figbot-canvas hidden aria-hidden="true"></canvas>
</div>

<script>
	import { mountFigbotDemo } from '../../../lib/figbot/mount';
	import { reportError } from '../../../lib/report';
	document.querySelectorAll<HTMLElement>('[data-figbot-demo]').forEach((el) => {
		try { mountFigbotDemo(el); } catch (err) { reportError(err); }
	});
</script>

<style>
	.figbot-demo {
		position: relative;
		width: 100%;
		max-width: 420px;
		aspect-ratio: 1;
		margin-inline: auto;
		border: 1px solid var(--color-subtle);
		background: #0A0A0A;
		overflow: hidden;
	}
	.layer { position: absolute; inset: 0; width: 100%; height: 100%; }
	.layer[hidden] { display: none; }
	.layer :global(svg) { display: block; width: 100%; height: 100%; }
</style>
