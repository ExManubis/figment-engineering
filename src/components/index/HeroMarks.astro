---
import { SMALL_CELLS } from '../../lib/logo/nav';
import { LOCATION, WORDMARK } from '../../lib/marks/text';

// the year the site was built, like the footer; the script types it out behind a cursor
const year = `© ${new Date().getFullYear()}`;
const SMALLCLAIMS = 'smallclaims.ai';
---

{/* the marks are decorative (the name and copyright are in the nav and footer); only the smallclaims link is read out */}
<div class="label flex w-full items-center justify-between lg:absolute lg:inset-x-0 lg:bottom-6 lg:px-6" data-hero-marks>
	<canvas class="no-js-hide dim" data-mark-cube width={SMALL_CELLS} height={SMALL_CELLS} aria-hidden="true"></canvas>
	<img class="js-hide dim" src="/favicon.svg" alt="" width={SMALL_CELLS} height={SMALL_CELLS} />
	<span class="mark dim" data-mark-wordmark aria-hidden="true">{WORDMARK}</span>
	<a class="smallclaims dim inline-flex items-center gap-2.5 max-sm:hidden" href="https://smallclaims.ai" target="_blank" rel="noopener" aria-label={SMALLCLAIMS} data-mark-smallclaims>
		<canvas class="no-js-hide" aria-hidden="true"></canvas>
		<span aria-hidden="true">{Array.from(SMALLCLAIMS, (c) => <span data-letter>{c}</span>)}</span>
	</a>
	<span class="mark dim max-sm:hidden" data-mark-location aria-hidden="true">{LOCATION}</span>
	<span class="mark dim" data-mark-copyright data-text={year} aria-hidden="true">{`${year} `}</span>
</div>

<script>
	import { mountHeroMarks } from '../../lib/marks/mount';
	import { reportError } from '../../lib/report';
	document.querySelectorAll<HTMLElement>('[data-hero-marks]').forEach((el) => {
		try { mountHeroMarks(el); } catch (err) { reportError(err); }
	});
</script>

<style>
	.mark { white-space: pre; line-height: 1.15; }
	.dim { opacity: 0.5; }
	/* grey like the rest of the row; white when hovered or focused, no other colour */
	.smallclaims { color: inherit; text-decoration: none; transition: opacity 0.2s; }
	.smallclaims:hover, .smallclaims:focus-visible { opacity: 1; }
	.smallclaims [data-letter] { display: inline-block; }
</style>
