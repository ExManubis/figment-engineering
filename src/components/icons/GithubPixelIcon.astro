---
// The GitHub mark redrawn on a 16 × 16 pixel grid; one unit per pixel, filled in currentColor.
const GRID = [
	'.....######.....',
	'...##########...',
	'..############..',
	'.###.######.###.',
	'.###........###.',
	'####........####',
	'###..........###',
	'###..........###',
	'###..........###',
	'###..........###',
	'####........####',
	'.#####....#####.',
	'.##.##....#####.',
	'..##......####..',
	'...###....###...',
	'.....#....#.....',
];
// one sub-path per horizontal run of filled pixels
const d = GRID.flatMap((row, y) =>
	[...row.matchAll(/#+/g)].map((m) => `M${m.index} ${y}h${m[0].length}v1h-${m[0].length}z`),
).join('');
---

<svg class="github-pixel" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d={d} fill="currentColor" /></svg>

<style>
	.github-pixel { flex: none; shape-rendering: crispEdges; }
</style>
