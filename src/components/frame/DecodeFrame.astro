---
interface Props {
	label: string;
	brand?: { primary: string; secondary?: string; gradient?: string[] };
}
const { label, brand } = Astro.props;
const style = brand
	? [
			`--brand: ${brand.primary};`,
			brand.secondary && `--brand-2: ${brand.secondary};`,
			brand.gradient && `--brand-gradient: linear-gradient(90deg, ${brand.gradient.join(', ')});`,
		].filter(Boolean).join(' ')
	: undefined;
---

<div class="decode-frame" data-decode-frame data-label={label} data-branded={brand ? '' : undefined} data-gradient={brand?.gradient ? '' : undefined} style={style}>
	<pre class="decode-frame__border" aria-hidden="true"></pre>
	<div class="decode-frame__content"><slot /></div>
</div>

<script>
	import { mountDecodeFrames } from '../../lib/decode/mount';
	mountDecodeFrames();
</script>

<style>
	.decode-frame {
		position: relative;
		--frame-color: var(--color-subtle);
		border: 1px solid var(--color-subtle); /* no-JS fallback */
	}
	:global(.js) .decode-frame[data-mounted]:not([data-failed]) { border-color: transparent; }
	.decode-frame[data-active][data-branded] { --frame-color: var(--brand); }
	.decode-frame[data-active][data-branded] :global(.ascii-header) { color: var(--brand); }
	/* the gradient sits under the glyphs the whole time; going active fades the glyph colour out to reveal it.
	   The header's gradient spans its lettering, the border's the whole frame. A header with its own
	   per-cell paint (the CGA art) shows that instead. */
	.decode-frame[data-gradient] :global(.ascii-header) {
		background: var(--header-paint, var(--brand-gradient)) 0 0 / calc(var(--cols) * 1ch) 100% no-repeat;
		-webkit-background-clip: text;
		background-clip: text;
	}
	.decode-frame[data-gradient] .decode-frame__border {
		background: var(--brand-gradient);
		-webkit-background-clip: text;
		background-clip: text;
	}
	.decode-frame[data-active][data-gradient] { --frame-color: transparent; }
	.decode-frame[data-active][data-gradient] :global(.ascii-header) { color: transparent; }
	/* per-cell paint carries the letter shapes (its glyphs are mostly solid blocks), so it always shows:
	   greyscale while inactive, in colour once active */
	.decode-frame[data-gradient] :global(.ascii-header[data-paint]) { color: transparent; filter: grayscale(1); transition: filter 0.6s; }
	.decode-frame[data-active][data-gradient] :global(.ascii-header[data-paint]) { filter: none; }
	.decode-frame__border {
		position: absolute;
		inset: 0;
		margin: 0;
		font-size: 13px;
		line-height: 16px;
		white-space: pre;
		overflow: hidden;
		pointer-events: none;
		color: var(--frame-color);
		transition: color 0.6s;
	}
	.decode-frame__content { position: relative; padding: 48px 24px; }
	@media (min-width: 640px) { .decode-frame__content { padding: 64px 56px; } }
</style>
